# Copy this file to .env and fill in values. DO NOT commit real secrets.
# Example:
# HUGGINGFACEHUB_API_TOKEN=hf_xxx... (your Hugging Face token)
# OPENAI_API_KEY=sk-...       (optional, if you re-enable OpenAI later)

HUGGINGFACEHUB_API_TOKEN=
HF_SUMMARY_MODEL=facebook/bart-large-cnn
HF_KEYWORD_MODEL=tiiuae/falcon-7b-instruct

# Optional / future:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
